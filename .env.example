# ScreenWise AI - Mobile App Environment Configuration

# Backend Server URL
# For local Android emulator use: http://10.0.2.2:5000
# For physical Android device use your computer's local Wi-Fi IP: http://192.168.x.x:5000
# For production use your deployed Render URL: https://screenwise-api.onrender.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000

# Supabase Authentication & Storage
# Get these from your Supabase Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

